# Copy file này thành .env rồi sửa. KHÔNG commit .env.

# --- browser ---
HEADLESS=false
LOCALE=vi-VN
CURRENCY=VND
TIMEZONE=Asia/Ho_Chi_Minh
PAGE_TIMEOUT_MS=60000

# Proxy HTTP có xác thực (để trống TRIP_PROXY_SERVER nếu dùng mạng trực tiếp).
# Ghi thông tin thật chỉ trong .env, không thêm vào Git.
TRIP_PROXY_ENABLED=false
# Cách 1: dán nguyên chuỗi nhà cung cấp cấp (host:port:user:pass)
TRIP_PROXY=
# Cách 2: điền từng trường (chỉ dùng khi TRIP_PROXY để trống)
TRIP_PROXY_SERVER=
TRIP_PROXY_USERNAME=
TRIP_PROXY_PASSWORD=

# --- tốc độ: giữ chậm, bị block một lần là mất cả buổi ---
MIN_DELAY=1.5
MAX_DELAY=3.5
MAX_CONCURRENCY=3
MAX_SCROLL_ROUNDS=25
SCROLL_PAUSE_MS=1500

# Chỉ đổi thành false khi đã hỏi và được anh Vũ đồng ý.
RESPECT_ROBOTS=true

# URL trang danh sách thật — copy từ thanh địa chỉ sau khi search trên vn.trip.com
TRIP_LIST_URL=https://vn.trip.com/hotels/list?city=359

# --- database ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=tripcom
DB_PASSWORD=tripcom
DB_NAME=tripcom
